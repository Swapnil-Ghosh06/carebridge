# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (gemini or anthropic)
LLM_API_KEY=
LLM_PROVIDER=gemini

# Demo mode — use seconds instead of hours for escalation delays
NEXT_PUBLIC_DEMO_MODE=true

# Set to true to skip Supabase entirely (uses in-memory store)
USE_LOCAL_STORE=false
